# ---------------------------------------------------------------- core
# Generate with: php bin/console key:generate
# Everything keyed (sessions, CSRF, visitor hashes) derives from this.
# Changing it signs everyone out and resets unique-visitor detection.
APP_KEY=

# The public origin. Codes encode this, so set it before printing anything.
APP_URL=http://localhost:8000

APP_DEBUG=false
APP_TIMEZONE=UTC

# ------------------------------------------------------------ database
# sqlite needs no server and is the right default for a single box.
DB_DRIVER=sqlite
DB_PATH=storage/qroute.sqlite

# For MySQL, set DB_DRIVER=mysql and fill these in:
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_NAME=qroute
#DB_USER=qroute
#DB_PASS=

# --------------------------------------------------------------- proxy
# Required for correct client IPs and CDN country headers behind a proxy.
# Comma separated CIDRs, or * to trust any upstream (only when the app is
# not reachable directly). Leave empty when serving without a proxy —
# trusting these headers unconditionally lets visitors spoof their own
# IP and country.
TRUSTED_PROXIES=

# ----------------------------------------------------------- behaviour
# Seconds the free-tier interstitial is shown before redirecting.
INTERSTITIAL_SECONDS=3

# Raw scan rows older than this are aggregated and deleted by `rollup`.
RAW_SCAN_RETENTION_DAYS=90

# Refuse destinations that resolve to private addresses. Turn off only
# when intentionally routing to an internal host.
BLOCK_PRIVATE_DNS=true

# Lets a signed-in user change their own plan without paying. Development
# only; must stay false in production.
ALLOW_SELF_SERVE_PLAN_CHANGE=false

# ----------------------------------------------------------- optional
# Ad markup injected into the free-tier interstitial.
#AD_SLOT_HTML=

# MaxMind GeoLite2 country database, if you want geo routing without a CDN.
#GEOIP_DB=/var/lib/GeoIP/GeoLite2-Country.mmdb

# Redis makes rate limiting cheaper; falls back to the database when unset.
#REDIS_HOST=127.0.0.1
#REDIS_PORT=6379
#REDIS_PASSWORD=
